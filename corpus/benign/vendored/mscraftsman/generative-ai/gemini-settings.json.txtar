{
  "model": {
    "maxSessionTurns": -1
  },
  "telemetry": {
    "enabled": false,
    "target": "gcp"
  },
  "debug": false,
  "experimental": {
    "gemmaModelRouter": {
      "enabled": true,
      "classifier": {
