{
  "permissions": {
    "allow": [
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/check-coauthor.py\""
          }
        ]
      }
    ]
  }
}
