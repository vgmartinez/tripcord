{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "tripcord",
          "rules": [
            {
              "id": "TC-CFG-006",
              "shortDescription": {
                "text": "Hook points outside the repository"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "MANAGED": {
          "description": {
            "text": "Managed configuration location."
          }
        }
      },
      "results": [
        {
          "ruleId": "TC-CFG-006",
          "level": "note",
          "message": {
            "text": "Hook points outside the repository: Point the hook at a versioned script. (/etc/cursor/hooks.json)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "etc/cursor/hooks.json",
                  "uriBaseId": "MANAGED"
                }
              }
            }
          ],
          "partialFingerprints": {
            "tripcord/fingerprint": "tcf_2222222222222222"
          },
          "properties": {
            "tripcord": {
              "scope": "managed",
              "path": "/etc/cursor/hooks.json"
            }
          }
        }
      ]
    }
  ]
}
