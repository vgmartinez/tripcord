{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "tripcord",
          "rules": [
            {
              "id": "TC-CFG-001",
              "shortDescription": {
                "text": "Hook downloads code"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "USERHOME": {
          "description": {
            "text": "The user's home directory."
          }
        }
      },
      "results": [
        {
          "ruleId": "TC-CFG-001",
          "level": "error",
          "message": {
            "text": "Hook downloads code: Remove the hook. (~/.claude/settings.json)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".claude/settings.json",
                  "uriBaseId": "USERHOME"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "tripcord/fingerprint": "tcf_1111111111111111"
          },
          "properties": {
            "tripcord": {
              "scope": "user",
              "path": "~/.claude/settings.json"
            }
          }
        }
      ]
    }
  ]
}
