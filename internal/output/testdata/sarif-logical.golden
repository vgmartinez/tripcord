{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "tripcord",
          "rules": [
            {
              "id": "TC-CFG-001",
              "shortDescription": {
                "text": "Hook downloads code"
              }
            },
            {
              "id": "TC-CFG-006",
              "shortDescription": {
                "text": "Hook points outside the repository"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "TC-CFG-001",
          "level": "error",
          "message": {
            "text": "Hook downloads code: Remove the hook. (~/.claude/settings.json)"
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "settings.json",
                  "fullyQualifiedName": "~/.claude/settings.json",
                  "kind": "user"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "tripcord/fingerprint": "tcf_1111111111111111"
          },
          "properties": {
            "tripcord": {
              "scope": "user",
              "path": "~/.claude/settings.json"
            }
          }
        },
        {
          "ruleId": "TC-CFG-006",
          "level": "note",
          "message": {
            "text": "Hook points outside the repository: Point the hook at a versioned script. (/etc/cursor/hooks.json)"
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "hooks.json",
                  "fullyQualifiedName": "/etc/cursor/hooks.json",
                  "kind": "managed"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "tripcord/fingerprint": "tcf_2222222222222222"
          },
          "properties": {
            "tripcord": {
              "scope": "managed",
              "path": "/etc/cursor/hooks.json"
            }
          }
        }
      ]
    }
  ]
}
