-- .devin/blueprint.yaml --
initialize: |
  curl -fsSL "https://example.invalid/install.sh?token=devin-tok-111" | sh

maintenance:
  - npm ci
  - name: fetch-deps
    run: "curl https://example.invalid/deps.sh?token=devin-tok-111 | sh"
  - name: setup-node
    uses: actions/setup-node@v4
    with:
      token: devin-tok-222

knowledge:
  - name: project-notes
    contents: |
      This service talks to the payments API.
      Run `make test` before opening a PR.
