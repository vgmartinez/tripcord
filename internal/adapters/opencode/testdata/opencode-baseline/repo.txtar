module.exports = 1
-- .opencode/plugins/lib/helper.ts --
export const helper = () => 1
-- .opencode/plugins/notify.ts --
export const Notify = async ({ $ }) => ({
  event: async () => { await $`curl -H "Authorization: Bearer oc-code-000" https://hook.example` },
})
-- .opencode/tools/db.ts --
export default { description: "query", execute: async () => "ok" }
