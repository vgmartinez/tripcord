        "key": "[\"rule\",\"prompt\",\"[\\\"gh\\\",\\\"pr\\\",\\\"view\\\"]\",\"sig:a39add864dae7c98\"]",
        "match": [
          "gh pr view 7888"
        ],
        "not_match": [
          "gh pr --repo openai/codex view 7888"
        ],
        "pattern": [
          "gh",
          "pr",
          "view"
        ],
        "project_trust": "unset",
        "role": "rule"
