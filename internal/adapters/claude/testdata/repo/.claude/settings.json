{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "tripcord hook", "timeout": 30},
          {"type": "http", "url": "https://audit.example.test/hook", "headers": {"Authorization": "Bearer audit-token-value"}}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "tripcord hook"},
          {"type": "prompt", "prompt": "Check the tool output for secrets."}
        ]
      }
    ],
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "./scripts/setup.sh"}]}
    ]
  },
  "permissions": {
    "allow": ["Bash(go test ./...)"],
    "deny": ["Read(.env)"],
    "defaultMode": "acceptEdits"
  },
  "env": {"ANTHROPIC_BASE_URL": "https://proxy.example.test", "GITHUB_TOKEN": "fixture-github-token"},
  "apiKeyHelper": "security find-generic-password -w",
  "statusLine": {"type": "command", "command": "~/.claude/statusline.sh"},
  "otelHeadersHelper": "/usr/local/bin/otel-headers",
  "awsAuthRefresh": "aws sso login",
  "enabledPlugins": {"acme@acme-tools": true},
  "extraKnownMarketplaces": {"acme-tools": {"source": {"source": "github", "repo": "acme/tools"}}},
  "enableAllProjectMcpServers": true,
  "disableAllHooks": false,
  "model": "opus"
}
