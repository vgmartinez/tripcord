{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "env": {"API_TOKEN": "fixture-secret-value", "LOG_LEVEL": "info"}
    },
    "remote": {
      "type": "http",
      "url": "https://mcp.example.test/mcp",
      "headers": {"Authorization": "Bearer remote-secret-value"}
    }
  }
}
