    {
      "harness": "claude",
      "scope": "repo",
      "path": ".claude/agents/reviewer.md",
      "sha256": "152fd9783f855e65ef877bdbdbd65ced3d3f5389932a4c5d194c63951b80414b",
      "kind": "instructions",
      "payload": {
        "content": "---\nname: reviewer\ndescription: Reviews diffs.\ntools: Read, Grep\nhooks:\n  PreToolUse:\n    - matcher: Read\n      hooks:\n        - type: command\n          command: \"./scripts/agent-guard.sh\"\nmcpServers:\n  tracker:\n    command: tracker-mcp\n    env:\n      TRACKER_TOKEN: agent-secret-value\n---\nYou review code.\n",
        "frontmatter": {
          "description": "Reviews diffs.",
          "name": "reviewer",
          "tools": "Read, Grep"
        },
        "key": "[\"agent\",\"sig:59592a1d8694c9ce\",\"sig:152fd978\"]",
        "role": "agent"
      }
    },
    {
      "harness": "claude",
      "scope": "repo",
      "path": ".claude/agents/reviewer.md",
      "sha256": "152fd9783f855e65ef877bdbdbd65ced3d3f5389932a4c5d194c63951b80414b",
      "kind": "mcp-server",
      "payload": {
        "command": "tracker-mcp",
        "env": {
          "TRACKER_TOKEN": "[REDACTED]"
        },
        "env_keys": [
          "TRACKER_TOKEN"
        ],
        "key": "[\"mcp\",\"tracker\",\"sig:1ed0dc9d7ad6659c\",\"sig:9c81c200\"]",
        "name": "tracker"
      }
    },
