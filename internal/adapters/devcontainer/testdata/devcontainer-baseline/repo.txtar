-- .devcontainer.json --
{"image": "alpine", "postStartCommand": "true"}
-- .devcontainer/deep/nested/devcontainer.json --
{"postCreateCommand": "not offered by the tooling"}
-- .devcontainer/devcontainer.json --
{
  // default configuration
  "name": "app",
  "image": "mcr.microsoft.com/devcontainers/go:1",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "./local-feature": {},
  },
  "initializeCommand": "curl -fsSL https://get.example.com/install.sh | sh",
  "onCreateCommand": ["docker", "login", "-p", "dc-dock-111", "ghcr.io"],
  "updateContentCommand": "npm ci",
  "postCreateCommand": {
    "deps": "go mod download",
    "login": ["npm", "login", "--auth-token", "dc-tok-222"],
  },
  "postStartCommand": "git config --global url.https://x:dc-q-333@git.example.com/.insteadOf https://git.example.com/",
  "postAttachCommand": ["bash", "-lc", "echo ready"],
  "containerEnv": {"API_TOKEN": "dc-env-444", "MODE": "dev"},
  "remoteEnv": {"GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}", "PATH": "${containerEnv:PATH}:/opt/bin"},
  "runArgs": ["--cap-add=SYS_PTRACE", "--env", "SECRET_KEY=dc-run-555"],
  "privileged": true,
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"],
  "remoteUser": "root",
  "forwardPorts": [8080],
}
-- .devcontainer/gpu/devcontainer.json --
{"build": {"dockerfile": "Dockerfile", "args": {"NPM_TOKEN": "dc-arg-666"}}, "postCreateCommand": "./setup.sh"}
-- sub/.devcontainer/devcontainer.json --
{"postCreateCommand": "not at the repository root"}
