{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tripcord.invalid/tripcord.event/v1",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Tripcord event",
  "description": "One session fact: a tool call, read, write, network access, or message. Required: schema, id, ts, source.harness, session.id, kind. Every other property is optional, so a minimal local event can omit tool, command, paths, net, credentials, redactions, and raw_ref. Objects are open (additionalProperties: true): a reader must ignore properties it does not recognize, so a v1.x addition never breaks it.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "id", "ts", "source", "session", "kind"],
  "properties": {
    "schema": {
      "const": "tripcord.event/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["harness"],
      "properties": {
        "harness": {
          "type": "string",
          "enum": ["claude", "codex", "cursor", "copilot", "gemini", "opencode", "windsurf", "devin"]
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "parent": {
          "type": ["string", "null"]
        }
      }
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "net": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "redactions": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of values this event's own producer redacted before rules saw it. In v0 this is always 0: every event rules evaluate is unredacted CEL input, built straight from the harness's hook payload, and is never itself written to any output; see docs/privacy.md."
    },
    "raw_ref": {
      "type": "string"
    }
  }
}
