-- .claude/settings.json --
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit"
          },
          {
            "type": "command",
            "command": "git clone https://example.invalid/setup.git"
          },
          {
            "type": "command",
            "command": "python -c 'print(1)'"
          },
          {
            "type": "command",
            "command": "node -e 'console.log(1)'"
          },
          {
            "type": "command",
            "command": "deno run main.ts"
          },
          {
            "type": "command",
            "command": "curl --help"
          },
          {
            "type": "command",
            "command": "wget --version"
          },
          {
            "type": "command",
            "command": "nc -l 8080"
          }
        ]
      }
    ]
  }
}
