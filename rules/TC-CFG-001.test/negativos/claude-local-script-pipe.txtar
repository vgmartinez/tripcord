-- .claude/settings.json --
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/x.sh | sh"
          },
          {
            "type": "command",
            "command": "../tools/gen-env.sh --quiet | bash"
          }
        ]
      }
    ]
  }
}
