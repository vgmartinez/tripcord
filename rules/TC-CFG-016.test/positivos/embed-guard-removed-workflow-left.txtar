-- .claude/settings.json --
{
  "hooks": {}
}
-- .gitattributes --
# Tripcord embed: bash needs LF, and tripcord scan hashes these files.
/.tripcord/bootstrap.sh text eol=lf
/.tripcord/embed.json text eol=lf
/.github/workflows/tripcord.yml text eol=lf
/.github/hooks/tripcord.json text eol=lf
-- .github/workflows/copilot-setup-steps.yml --
# Written by tripcord init --embed.
name: Copilot Setup Steps

on:
  workflow_dispatch:
  push:
    paths:
      - .github/workflows/copilot-setup-steps.yml
  pull_request:
    paths:
      - .github/workflows/copilot-setup-steps.yml

permissions:
  contents: read

concurrency:
  group: copilot-setup-steps-${{ github.ref }}
  cancel-in-progress: true

jobs:
  copilot-setup-steps:
    name: Copilot setup steps
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read # checkout the repository
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Tripcord bootstrap
        run: bash .tripcord/bootstrap.sh install
-- .github/workflows/tripcord.yml --
# Written by tripcord init --embed.
# Scans pull requests that touch agent configuration. pull_request only:
# never pull_request_target, so a fork's head never runs with write
# access or secrets.
name: tripcord

on:
  pull_request:
    paths:
      - ".claude/**"
      - ".cursor/**"
      - ".codex/**"
      - ".github/**"
      - ".vscode/**"
      - ".mcp.json"
      - "AGENTS.md"
      - "CLAUDE.md"
      - "GEMINI.md"
      - ".devin/**"
      - ".tripcord/**"

permissions:
  contents: read

jobs:
  scan:
    permissions:
      contents: read # checkout the repository being scanned
      pull-requests: read # tripcord-pr.yml reads pull request reviews
      security-events: write # upload the SARIF report
    # Reusable workflow pinned by full commit SHA (main@6a12795).
    uses: vgmartinez/tripcord/.github/workflows/tripcord-pr.yml@6a1279565e9e41e9dec163e6bedf07f2647a2c67 # main@6a12795 # zizmor: ignore[ref-version-mismatch]
    with:
      fail-on: high
-- .gitignore --
/.tripcord/policy.local.yaml
-- .tripcord/policy.yaml --
# Tripcord policy. See docs/policy.md for every field.
version: 1
mode: enforce
fail-on: high
