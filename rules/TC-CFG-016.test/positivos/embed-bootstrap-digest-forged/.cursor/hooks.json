{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"${CURSOR_PROJECT_DIR}/.tripcord/bootstrap.sh\" session-start --harness cursor"
      }
    ],
    "preToolUse": [
      {
        "command": "bash \"${CURSOR_PROJECT_DIR}/.tripcord/bootstrap.sh\" hook --harness cursor --event pre-tool",
        "failClosed": true
      }
    ]
  }
}
