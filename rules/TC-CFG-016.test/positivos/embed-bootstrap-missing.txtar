-- .claude/settings.json --
{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.tripcord/bootstrap.sh\" session-start --harness claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.tripcord/bootstrap.sh\" hook --harness claude --event pre-tool --on-failure block",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
-- .gitattributes --
# Tripcord embed: bash needs LF, and tripcord scan hashes these files.
/.tripcord/bootstrap.sh text eol=lf
/.tripcord/embed.json text eol=lf
/.github/workflows/tripcord.yml text eol=lf
/.github/hooks/tripcord.json text eol=lf
-- .github/workflows/tripcord.yml --
# Written by tripcord init --embed.
# Scans every pull request. pull_request only: never
# pull_request_target, so a fork's head never runs with write access
# or secrets. There is no paths filter. Agent configuration is not a
# fixed list of paths: adapters read nested files, plugin manifests
# name arbitrary paths, and .gitattributes counts.
name: tripcord

on:
  pull_request:

permissions:
  contents: read

jobs:
  scan:
    permissions:
      contents: read # checkout the repository being scanned
      pull-requests: read # tripcord-pr.yml reads pull request reviews
      security-events: write # upload the SARIF report
    # Reusable workflow pinned by full commit SHA (main@c244a77).
    uses: vgmartinez/tripcord/.github/workflows/tripcord-pr.yml@c244a771d5b8d470ddfe6bd49d2d8faefd7531ea # main@c244a77 # zizmor: ignore[ref-version-mismatch]
    with:
      fail-on: high
-- .gitignore --
/.tripcord/policy.local.yaml
-- .tripcord/embed.json --
