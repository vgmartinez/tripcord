-- .claude/settings.json --
{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.tripcord/bootstrap.sh\" session-start --harness claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.tripcord/bootstrap.sh\" hook --harness claude --event pre-tool --on-failure block",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
-- .gitattributes --
# Tripcord embed: bash needs LF, and tripcord scan hashes these files.
/.tripcord/bootstrap.sh text eol=lf
/.tripcord/embed.json text eol=lf
/.github/workflows/tripcord.yml text eol=lf
/.github/hooks/tripcord.json text eol=lf
-- .github/workflows/tripcord.yml --
# Written by tripcord init --embed.
# Scans pull requests that touch agent configuration. pull_request only:
# never pull_request_target, so a fork's head never runs with write
# access or secrets.
name: tripcord

on:
  pull_request:
    paths:
      - ".claude/**"
      - ".cursor/**"
      - ".codex/**"
      - ".github/**"
      - ".vscode/**"
      - ".mcp.json"
      - "AGENTS.md"
      - "CLAUDE.md"
      - "GEMINI.md"
      - ".devin/**"
      - ".tripcord/**"

permissions:
  contents: read

jobs:
  scan:
    permissions:
      contents: read # checkout the repository being scanned
      pull-requests: read # tripcord-pr.yml reads pull request reviews
      security-events: write # upload the SARIF report
    # Reusable workflow pinned by full commit SHA (main@6a12795).
    uses: vgmartinez/tripcord/.github/workflows/tripcord-pr.yml@6a1279565e9e41e9dec163e6bedf07f2647a2c67 # main@6a12795 # zizmor: ignore[ref-version-mismatch]
    with:
      fail-on: high
-- .gitignore --
/.tripcord/policy.local.yaml
-- .tripcord/embed.json --
