-- .claude/settings.json --
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go test ./...)",
      "Bash(npm run test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Read(./docs/**)",
      "Read(src/**/*.ts)",
      "Edit(./src/**)",
      "WebFetch(domain:docs.example.invalid)",
      "mcp__github__get_issue",
      "Write(./dist/**)"
    ],
    "ask": [
      "Bash(*)"
    ],
    "deny": [
      "Read(*)",
      "Bash(curl:*)",
      "WebFetch(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "tripcord hook --harness claude --event pre-tool"
          }
        ]
      }
    ]
  }
}
