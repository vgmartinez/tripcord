{
  "mcpServers": {
    "filesystem": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "."]},
    "git": {"command": "uvx", "args": ["mcp-server-git", "--repository", "."]},
    "github": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "cfg003-neg-secret"}
    },
    "tracker": {"type": "stdio", "command": "/usr/local/bin/tracker-mcp", "args": ["--log-level", "info"]},
    "lint": {"command": "shellcheck-mcp", "args": ["--shell", "sh", "--severity", "warning"]},
    "bash-lsp": {"command": "bash-language-server", "args": ["start"]},
    "local": {"command": "node", "args": ["./tools/mcp/server.js", "--mode", "a||b"]},
    "remote": {"type": "http", "url": "https://mcp.example.invalid/mcp"}
  }
}
