-- .cursor/hooks.json --
{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "echo '{\"permission\": \"deny\", \"userMessage\": \"Shell is disabled in this repo\"}'"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "echo '{\"permission\": \"ask\"}'"
      }
    ]
  }
}
