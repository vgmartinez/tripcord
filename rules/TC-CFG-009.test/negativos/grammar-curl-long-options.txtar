-- .github/workflows/copilot-setup-steps.yml --
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    steps:
      - run: "curl --fail --silent --location --output t.sh https://get.tools.example.invalid/t.sh && sha256sum --check t.sh.sha256 && bash t.sh"
        shell: "bash {0}"
-- t.sh.sha256 --
abababababababababababababababababababababababababababababababab  t.sh
