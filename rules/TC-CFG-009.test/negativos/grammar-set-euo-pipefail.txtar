-- .github/workflows/copilot-setup-steps.yml --
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    steps:
      - run: "set -euo pipefail\ncurl -fsSLo t.sh https://get.tools.example.invalid/t.sh\nsha256sum -c t.sh.sha256\nsh t.sh\n"
        shell: "bash {0}"
-- t.sh.sha256 --
abababababababababababababababababababababababababababababababab  t.sh
