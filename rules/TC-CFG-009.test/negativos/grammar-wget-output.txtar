-- .github/workflows/copilot-setup-steps.yml --
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    steps:
      - run: "wget -qO t.sh https://get.tools.example.invalid/t.sh && sha256sum -c t.sh.sha256 && sh t.sh"
        shell: "bash {0}"
-- t.sh.sha256 --
abababababababababababababababababababababababababababababababab  t.sh
