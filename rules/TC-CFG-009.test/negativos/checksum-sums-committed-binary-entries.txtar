-- .github/workflows/copilot-setup-steps.yml --
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: step0
        run: "curl -fsSLo t.sh https://get.tools.example.invalid/t.sh; shasum -a 256 -c SHA256SUMS; sh t.sh"
-- SHA256SUMS --
abababababababababababababababababababababababababababababababab *other.tgz
abababababababababababababababababababababababababababababababab *t.sh
