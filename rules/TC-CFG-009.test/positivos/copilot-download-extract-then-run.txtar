-- .github/workflows/copilot-setup-steps.yml --
name: Copilot Setup Steps
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    steps:
      - name: Tool
        run: |
          curl -fsSL https://example.invalid/tool.tar.gz -o tool.tar.gz
          tar -xzf tool.tar.gz
          ./tool/install.sh
      - name: Clone and run
        run: |
          git clone https://example.invalid/org/helper.git /tmp/helper
          bash /tmp/helper/setup.sh
