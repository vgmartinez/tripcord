-- .github/workflows/copilot-setup-steps.yml --
name: Copilot Setup Steps
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    steps:
      - name: Fetch tool
        run: |
          curl -fsSL https://example.invalid/tool-1.0.tar.gz -o tool.tar.gz
          mkdir -p tool
          tar -xzf tool.tar.gz -C tool
      - name: Install tool
        run: ./tool/install.sh
