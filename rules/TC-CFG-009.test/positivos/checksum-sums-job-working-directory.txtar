-- .github/workflows/copilot-setup-steps.yml --
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: sub
    steps:
      - uses: actions/checkout@v4
      - name: step0
        run: "curl -fsSLo t.sh https://get.tools.example.invalid/t.sh && sha256sum -c t.sh.sha256 && sh t.sh"
-- t.sh.sha256 --
abababababababababababababababababababababababababababababababab  t.sh
