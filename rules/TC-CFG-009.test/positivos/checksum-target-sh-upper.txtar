-- .github/workflows/copilot-setup-steps.yml --
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: step0
        run: "curl -fsSLo SH https://get.tools.example.invalid/t.sh && curl -fsSLo t.sh https://get.tools.example.invalid/t.sh && echo 'abababababababababababababababababababababababababababababababab  t.sh' | sha256sum -c && echo 'abababababababababababababababababababababababababababababababab  SH' | sha256sum -c && sh t.sh"
