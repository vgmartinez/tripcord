-- .github/workflows/copilot-setup-steps.yml --
on: workflow_dispatch
jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    steps:
      - run: "curl -fsSLo t.sh https://get.tools.example.invalid/t.sh; echo \"abababababababababababababababababababababababababababababababab  t.sh\" | sha256sum -c - | tee log; sh t.sh"
